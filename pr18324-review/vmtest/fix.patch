 {
 	if (vd == vd->vdev_top && !vd->vdev_ishole && vd->vdev_ashift != 0) {
@@ -5400,6 +5400,13 @@ vdev_get_deflate_ratio(vdev_t *vd, uint64_t birth_txg)
